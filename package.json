{
  "name": "the-hollow-crown",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run build -- --base=/the-hollow-crown/",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write 'src/**/*.ts' 'tests/**/*.ts' vite.config.ts tsconfig.json .oxfmtrc.json .oxlintrc.json",
    "format:check": "oxfmt --check 'src/**/*.ts' 'tests/**/*.ts' vite.config.ts tsconfig.json .oxfmtrc.json .oxlintrc.json",
    "lint": "oxlint --max-warnings=0 src tests vite.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "check": "npm test && npm run lint && npm run format:check",
    "check:full": "npm run test:full && npm run lint && npm run format:check",
    "preview": "vite preview --host 0.0.0.0",
    "preview:pages": "npm run preview -- --base=/the-hollow-crown/",
    "test": "npm run typecheck && npm run test:core",
    "test:core": "node --test --test-concurrency=4 --test-skip-pattern=\"^\\[extended\\] \" \"tests/*.test.ts\"",
    "test:extended": "npm run typecheck && node --test --test-concurrency=4 --test-name-pattern=\"^\\[extended\\] \" \"tests/*.test.ts\"",
    "test:full": "npm run typecheck && node --test --test-concurrency=4 \"tests/*.test.ts\"",
    "test:timings": "npm run typecheck && node --test --test-concurrency=4 --test-reporter=./tests/timingReporter.ts \"tests/*.test.ts\"",
    "test:models": "npm run typecheck && node --test --test-skip-pattern=\"^\\[extended\\] \" tests/models.test.ts",
    "report:generation": "npm run typecheck && node tests/generation-corpus.ts",
    "test:generation": "node tests/generation-browser.ts",
    "gallery:generation": "npm run typecheck && node tests/generation-gallery.ts",
    "test:browser": "node tests/browser.ts",
    "test:production": "node tests/production.ts",
    "test:resources": "node tests/resources-browser.ts",
    "test:portraits": "node tests/portraits.ts",
    "test:inspection": "node tests/inspection-browser.ts",
    "test:discoveries": "node tests/discoveries-browser.ts",
    "test:objective-work": "node tests/objective-work-browser.ts",
    "test:last-ember": "node tests/last-ember-browser.ts",
    "test:tribute": "node tests/tribute-browser.ts",
    "test:movement": "node tests/movement-browser.ts",
    "test:animation": "node tests/animation-browser.ts",
    "test:animation:review": "node tests/animation-review-browser.ts",
    "test:rig": "node tests/rig-browser.ts",
    "test:rig:solver": "node tests/rig-solver-browser.ts",
    "test:rig:actions": "node tests/rig-actions-browser.ts",
    "test:rig:tails": "node tests/rig-tail-browser.ts",
    "test:rig:tails:clearance": "node tests/rig-tail-clearance-browser.ts",
    "test:rig:shield": "node tests/rig-shield-browser.ts",
    "test:rig:shield:transitions": "node tests/rig-shield-transitions-browser.ts",
    "test:rig:handoff": "node tests/rig-handoff-browser.ts",
    "test:rig:handoff:landing": "node tests/rig-handoff-landing-browser.ts",
    "test:ragdoll": "node tests/ragdoll-browser.ts",
    "test:ragdoll:contacts": "node tests/ragdoll-contacts-browser.ts",
    "test:jump": "node tests/jump-browser.ts",
    "test:combat": "node tests/combat-browser.ts",
    "test:defense": "node tests/defense-browser.ts",
    "test:phalanx": "node tests/phalanx-browser.ts",
    "test:social": "node tests/social-browser.ts",
    "profile": "node tests/profile.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check",
    "preserveUnused": true
  },
  "dependencies": {
    "@babylonjs/core": "9.37.0",
    "@babylonjs/materials": "9.37.0",
    "cannon-es": "0.20.0",
    "xstate": "5.33.4"
  },
  "devDependencies": {
    "@babylonjs/inspector": "9.37.0",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
